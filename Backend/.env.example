# Copy this file to .env and fill in real values. Never commit the real
# .env file. Get a Groq key from https://console.groq.com/keys

# Minimum required: at least GROQ_API_KEY. If GROQ_API_KEY_A/B/C are left
# unset, every agent falls back to GROQ_API_KEY and shares one rate limit
# budget. Setting all three separately spreads Agent 1, 2 and 5's traffic
# across three budgets, which avoids most 429 errors under concurrent load.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_A=
GROQ_API_KEY_B=
GROQ_API_KEY_C=

# CockroachDB Cloud connection. Found on the cluster's Connect screen in
# the Cloud Console.
COCKROACH_HOST=your-cluster-host.cockroachlabs.cloud
COCKROACH_USER=your_sql_user
COCKROACH_PASSWORD=your_sql_password
COCKROACH_PORT=26257
COCKROACH_DB=defaultdb

# Optional tuning. Match these to the real limits shown at
# console.groq.com/settings/limits for each key.
GROQ_TPM_SEARCH_MODEL=12000
GROQ_TPM_LIGHT_MODEL=15000
GROQ_MAX_TOKENS_SEARCH_MODEL=1400
GROQ_MAX_TOKENS_LIGHT_MODEL=1400
GROQ_SEARCH_MODEL=groq/compound-mini
GROQ_LIGHT_MODEL=openai/gpt-oss-20b
GROQ_LIGHT_REASONING_EFFORT=low

# Optional. Comma separated list of allowed frontend origins. Leave as *
# for local development only.
ALLOWED_ORIGINS=*

# Optional. If set, every request except /, /docs, /openapi.json and
# /redoc must include a matching X-API-Key header.
SENTINEL_API_KEY=
